import "design/tokens.elyx" as tokens
import "design/memorial-screen.elyx" as memorialScreen

export tributeScreen = frame : memorialScreen.MemorialScreen {
  left: 40px,
  top: 40px,

  bottomFooter {
    overrides: [
      insert(
        footerDetails,
        after = memorialScreen.footerLibrary.Footer.footerHeading
      ),
      remove(memorialScreen.footerLibrary.Footer.footerRoles),
      remove(memorialScreen.footerLibrary.Footer.footerDates)
    ],

    footerCopyright {
      fill[0].color: tokens.colors.brand900
    }

    left: 0px,
    top: 0px,
    width: 1200px,
    height: 100%,
    layout.item-gap: 32px
  }

  mainContentStack {
    rsvpSection {
      rsvpHeader {
        rsvpTag {
          font-size: 10,
          letter-spacing: 25%
        }
      }
    }

    memoryBook {
      passcodeBox {
        overrides: [
          insert(
            layer1,
            after = memorialScreen.memoryBookCardLibrary.MemoryBookCard.passcodeBox.pcTitle
          ),
          remove(
            memorialScreen.memoryBookCardLibrary.MemoryBookCard.passcodeBox.pcDesc
          )
        ],

        pcInputRow {
          unlockBtn {
            height: 100%
          }

          inputBox {
            inputPlaceholder {
              font-size: 12,
              font-family: "Cabin",
              font-style: "Regular"
            }
          }
        }
      }

      bookHeader {
        bookTag {
          font-style: "Regular",
          font-family: "Cabin"
        }
      }
    }

    gatheringDetails {
      left: 170px,
      top: 1061px,
      height: 458px,

      infoColumnsRow {
        dateTimeCol {
          height: 100%
        }
      }
    }

    framedFlyer {
      left: 170px,
      top: 48px,
      height: 1085px,

      serviceDetailsBlock {
        layout.item-gap: 24px
      }

      headerBlock {
        overrides: [
          insert(GroupedStack, after = .nil),
          remove(
            memorialScreen.flyerCardLibrary.FlyerCard.headerBlock.personName
          ),
          remove(
            memorialScreen.flyerCardLibrary.FlyerCard.headerBlock.tributeTag
          )
        ],
        layout.item-gap: 24px
      }
    }
  }

  layer1 = frame {
    left: 24px,
    top: 58px,
    width: 75%,
    height: 42px,
    overflow: .visible,
    children: pcDesc
  }

  pcDesc = text {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 42px,
    fill: tokens.colors.brand700,
    contents: "To keep this space private and meaningful for Rick’s family, please enter the family passcode from your invitation or flyer to share a memory.",
    font-size: 12,
    font-family: tokens.typography.fontSans,
    line-height: 1.75,
    align: .center
  }

  layer2 = frame {
    left: 356.5px,
    top: 103px,
    width: 487px,
    height: 61px,
    overflow: .visible,
    children: [footerDates, footerRoles]
  }

  footerDates = text {
    left: 134px,
    top: 0px,
    width: 219px,
    height: 24px,
    fill: tokens.colors.brand400,
    contents: "October 5, 1957 — June 8, 2026",
    font-size: 20,
    font-family: tokens.typography.fontSerif,
    font-style: "Italic"
  }

  footerRoles = text {
    left: 0px,
    top: 48px,
    width: 487px,
    height: 13px,
    fill: tokens.colors.brand500,
    contents: "HUSBAND — FATHER — PAPA — SON — BROTHER — UNCLE — FRIEND",
    font-size: 11,
    font-family: tokens.typography.fontSans,
    letter-spacing: 25%
  }

  footerDetails = frame {
    layout: {direction: .column, align-items: .center, item-gap: 24px},
    overflow: .visible,
    children: layer2
  }

  tributeTag = text {
    left: 155px,
    top: 0px,
    width: 125px,
    height: 24px,
    fill: tokens.colors.brand700,
    contents: "A Tribute to Rick",
    font-size: 20,
    font-family: tokens.typography.fontSerif,
    font-style: "Italic"
  }

  personName = text {
    left: 0px,
    top: 96px,
    width: 435px,
    height: 58px,
    fill: tokens.colors.brand950,
    contents: "Richard Earl LaDow Jr.",
    font-size: 48,
    font-family: tokens.typography.fontSerif
  }

  GroupedStack = frame {
    left: 164.5px,
    top: 0px,
    width: 435px,
    height: .auto,
    layout: {direction: .column, align-items: .center, item-gap: 10px},
    overflow: .visible,
    children: [tributeTag, personName]
  }
}
