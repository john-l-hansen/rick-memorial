import "design/tokens.elyx" as tokens
import "design/memorial-screen.elyx" as memorialScreen

export tributeScreen = frame : memorialScreen.MemorialScreen {
  left: 40px,
  top: 40px,

  mainContentStack {
    memoryBook {
      passcodeBox {
        overrides: [
          insert(
            layer1,
            after = memorialScreen.memoryBookCardLibrary.MemoryBookCard.passcodeBox.pcTitle
          ),
          remove(
            memorialScreen.memoryBookCardLibrary.MemoryBookCard.passcodeBox.pcDesc
          )
        ]
      }

      bookHeader {
        bookTag {
          font-family: "Cabin",
          font-style: "Regular"
        }
      }
    }

    gatheringDetails {
      infoColumnsRow {
        dateTimeCol {
          height: 100%
        }
      }
    }
  }

  layer1 = frame {
    left: 24px,
    top: 58px,
    width: 75%,
    height: 42px,
    overflow: .visible,
    children: pcDesc
  }

  pcDesc = text {
    left: 0px,
    top: 0px,
    width: 100%,
    height: 42px,
    fill: tokens.colors.brand700,
    contents: "To keep this space private and meaningful for Rick’s family, please enter the family passcode from your invitation or flyer to share a memory.",
    font-size: 12,
    font-family: tokens.typography.fontSans,
    line-height: 1.75,
    align: .center
  }
}
