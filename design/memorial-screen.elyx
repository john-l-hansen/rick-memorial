// memorial-screen.elyx - Complete Memorial Screen honoring Richard Earl LaDow Jr.

import "./tokens.elyx" as tokens
import "./components/Button.elyx" as Button
import "./components/EventDetailsCard.elyx" as EventDetailsCard
import "./components/PhotoGallery.elyx" as PhotoGallery

screen MemorialScreen {
  width = 1280
  height = auto
  backgroundColor = tokens.colors.bgCanvas

  // 1. Navigation / Top Bar
  frame TopNav {
    width = 100%
    paddingHorizontal = tokens.spacing.xl
    paddingVertical = tokens.spacing.md
    layout = horizontal
    justify = space-between
    alignment = center
    borderBottom = { width = 1, color = tokens.colors.borderSubtle }
    backgroundColor = tokens.colors.bgSurface

    text SiteBrand {
      content = "IN LOVING MEMORY"
      style = tokens.typography.eyebrow
      color = tokens.colors.primary700
    }

    frame NavLinks {
      layout = horizontal
      gap = tokens.spacing.lg
      
      text LinkService {
        content = "Service Details"
        style = tokens.typography.bodySmall
        color = tokens.colors.textSecondary
      }
      text LinkStory {
        content = "Life & Tribute"
        style = tokens.typography.bodySmall
        color = tokens.colors.textSecondary
      }
      text LinkPhotos {
        content = "Photos"
        style = tokens.typography.bodySmall
        color = tokens.colors.textSecondary
      }
      text LinkRSVP {
        content = "RSVP"
        style = tokens.typography.bodySmall
        color = tokens.colors.primary900
        weight = 600
      }
    }
  }

  // 2. Hero Section (Warm, Emotional, matching Lindy LaDow Hero style)
  frame HeroSection {
    width = 100%
    layout = vertical
    alignment = center
    paddingVertical = tokens.spacing.section
    paddingHorizontal = tokens.spacing.xl
    gap = tokens.spacing.lg
    backgroundColor = tokens.colors.primary50

    text Eyebrow {
      content = "A TRIBUTE TO RICK"
      style = tokens.typography.eyebrow
      color = tokens.colors.primary700
    }

    text NameHeading {
      content = "Richard Earl LaDow Jr."
      style = tokens.typography.heroDisplay
      color = tokens.colors.textPrimary
    }

    text LifeDates {
      content = "October 5, 1957 — June 8, 2026"
      style = tokens.typography.bodyLead
      color = tokens.colors.primary800
    }

    text RolesSubtitle {
      content = "HUSBAND — FATHER — PAPA — SON — BROTHER — UNCLE — FRIEND"
      style = tokens.typography.eyebrow
      color = tokens.colors.primary600
    }

    text PersonalQuote {
      content = "“Truly, a loving brother to all.”"
      font = tokens.typography.fontSerif
      size = 24
      style = italic
      color = tokens.colors.primary900
    }

    frame HeroCTA {
      layout = horizontal
      gap = tokens.spacing.md
      
      instance RSVPButton of Button {
        style = "primary"
        label.content = "RSVP for the Memorial"
      }
      instance StoryButton of Button {
        style = "outline"
        label.content = "Read Rick's Story"
      }
    }
  }

  // 3. Main Content Container
  frame MainContent {
    width = 1000
    layout = vertical
    alignment = center
    gap = tokens.spacing.section
    paddingVertical = tokens.spacing.section

    // Event Card Component
    instance GatheringCard of EventDetailsCard {
      width = 100%
    }

    // Story / Tribute Section
    frame StorySection {
      width = 100%
      layout = vertical
      backgroundColor = tokens.colors.bgSurface
      padding = tokens.spacing.xl
      cornerRadius = tokens.radii.md
      gap = tokens.spacing.md
      border = { width = 1, color = tokens.colors.borderSubtle }
      shadow = tokens.shadows.card

      text StoryTagline {
        content = "HONORING HIS MEMORY"
        style = tokens.typography.eyebrow
        color = tokens.colors.primary700
      }

      text StoryHeading {
        content = "Celebrating Rick's Life & Legacy"
        style = tokens.typography.headingH2
        color = tokens.colors.textPrimary
      }

      text StoryBody {
        content = "Please join us for a private gathering to celebrate Rick, remember the life he lived, and honor the love, laughter, friendship, and memories he left with each of us.\n\nThroughout his life, Rick touched countless hearts with his kindness, humor, and unwavering devotion to family and friends. We welcome all who knew and loved him to share in this special afternoon of remembrance and reflection."
        style = tokens.typography.bodyLead
        color = tokens.colors.textSecondary
      }
    }

    // Photo Gallery Section
    instance Gallery of PhotoGallery {
      width = 100%
    }
  }

  // 4. Footer
  frame PageFooter {
    width = 100%
    backgroundColor = tokens.colors.primary975
    paddingVertical = tokens.spacing.xl
    paddingHorizontal = tokens.spacing.xl
    layout = vertical
    alignment = center
    gap = tokens.spacing.sm

    text FooterName {
      content = "Richard Earl LaDow Jr. (1957 — 2026)"
      font = tokens.typography.fontSerif
      size = 18
      color = tokens.colors.primary200
    }

    text FooterNote {
      content = "With love from his family and friends."
      style = tokens.typography.bodySmall
      color = tokens.colors.primary400
    }
  }
}
