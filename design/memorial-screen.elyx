import "design/tokens.elyx" as tokens
import "design/components/Navbar.elyx" as navbarLibrary
import "design/components/FlyerCard.elyx" as flyerCardLibrary
import "design/components/EventDetailsCard.elyx" as eventDetailsCardLibrary
import "design/components/MemoryBookCard.elyx" as memoryBookCardLibrary
import "design/components/RSVPCard.elyx" as rsvpCardLibrary
import "design/components/Footer.elyx" as footerLibrary

export MemorialScreen = frame {
  left: 0px,
  top: 0px,
  width: 1200px,
  layout: {direction: .column, align-items: .center},
  fill: tokens.colors.bgCanvas,
  children: [topNav, mainContentStack, bottomFooter],

  // 1. Navigation Bar
  topNav = frame : navbarLibrary.Navbar {
    width: 100%,

    navbarLibrary.Navbar.navLinks {
      navbarLibrary.Navbar.navLinks.rsvpBtn {
        navbarLibrary.Navbar.navLinks.rsvpBtn.rsvpLabel {
          font-family: "Cabin",
          font-style: "Regular"
        }
      }

      navbarLibrary.Navbar.navLinks.linkMemories {
        font-size: 10,
        font-family: "Cabin",
        font-style: "Regular"
      }

      navbarLibrary.Navbar.navLinks.linkPhotos {
        font-size: 10,
        font-family: "Cabin",
        font-style: "Regular"
      }

      navbarLibrary.Navbar.navLinks.linkDetails {
        font-size: 10,
        font-family: "Cabin",
        font-style: "Regular"
      }
    }

    navbarLibrary.Navbar.brandLink {
      left: 32px,
      top: 23px,
      width: 175px,
      height: 17px,

      navbarLibrary.Navbar.brandLink.brandTitle {
        font-size: 12,
        font-style: "Medium",
        letter-spacing: 5%
      }
    }
  }

  // 2. Main Body Content (Matching app/page.tsx layout)
  mainContentStack = frame {
    left: 0px,
    top: 63px,
    width: 1200px,
    height: 2651px,
    layout: {direction: .column, align-items: .center, item-gap: 48px},
    padding: [48px, 0px, 64px],
    children: [framedFlyer, gatheringDetails, memoryBook, rsvpSection],

    framedFlyer = frame : flyerCardLibrary.FlyerCard {}

    gatheringDetails = frame : eventDetailsCardLibrary.EventDetailsCard {
      eventDetailsCardLibrary.EventDetailsCard.infoColumnsRow {
        eventDetailsCardLibrary.EventDetailsCard.infoColumnsRow.locationCol {
          eventDetailsCardLibrary.EventDetailsCard.infoColumnsRow.locationCol.locVenue {
            font-size: 14,
            font-family: "Cabin",
            font-style: "Regular"
          }

          eventDetailsCardLibrary.EventDetailsCard.infoColumnsRow.locationCol.locHeading {
            font-size: 14
          }
        }

        eventDetailsCardLibrary.EventDetailsCard.infoColumnsRow.dateTimeCol {
          height: 100%,

          eventDetailsCardLibrary.EventDetailsCard.infoColumnsRow.dateTimeCol.dtDate {
            font-size: 14,
            font-family: "Cabin",
            font-style: "Regular"
          }

          eventDetailsCardLibrary.EventDetailsCard.infoColumnsRow.dateTimeCol.dtHeading {
            font-size: 14
          }
        }
      }
    }

    memoryBook = frame : memoryBookCardLibrary.MemoryBookCard {}

    rsvpSection = frame : rsvpCardLibrary.RSVPCard {
      rsvpCardLibrary.RSVPCard.formContainer {
        rsvpCardLibrary.RSVPCard.formContainer.submitBtn {
          rsvpCardLibrary.RSVPCard.formContainer.submitBtn.submitLabel {
            font-family: "Cabin",
            font-style: "SemiBold"
          }
        }
      }
    }
  }

  // 3. Page Footer
  bottomFooter = frame : footerLibrary.Footer {
    width: 100%,

    footerLibrary.Footer.footerRoles {
      letter-spacing: 25%
    }
  }
}
