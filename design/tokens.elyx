// tokens.elyx - Design Tokens for Rick's Memorial

tokens {
  colors {
    bgPrimary = #FDFCF7
    bgCard = #FFFFFF
    bgAccent = #F4EFE6
    textPrimary = #1E293B
    textSecondary = #64748B
    textMuted = #94A3B8
    accentWarm = #A47854
    accentWarmDark = #835C3C
    borderSubtle = #EAE4D9
  }

  typography {
    fontSerif = "Playfair Display, Cormorant Garamond, serif"
    fontSans = "Inter, -apple-system, BlinkMacSystemFont, sans-serif"
    
    titleHero = {
      font = fontSerif
      size = 38
      weight = 700
      lineHeight = 1.2
    }
    
    subtitle = {
      font = fontSans
      size = 14
      weight = 600
      letterSpacing = 1.5
    }
    
    body = {
      font = fontSans
      size = 16
      weight = 400
      lineHeight = 1.6
    }

    bodySmall = {
      font = fontSans
      size = 14
      weight = 400
      lineHeight = 1.5
    }
  }

  spacing {
    xs = 4
    sm = 8
    md = 16
    lg = 24
    xl = 32
    xxl = 48
  }

  radii {
    sm = 4
    md = 8
    lg = 16
    full = 9999
  }
}
