import "../tokens.elyx" as tokens

export Button = frame {
  name: "Button",
  left: 0px,
  top: 0px,
  children: [label],
  layout: { direction: .row, align-items: .center, justify-content: .center, item-gap: 8px },
  padding: [12px, 24px],
  corner-radius: tokens.lengths.radius-sm,
  fill: tokens.colors.brand900,

  label = text {
    contents: "RSVP via Email",
    font-size: 14,
    font-family: tokens.typography.fontSans,
    fill: tokens.colors.textLight
  }
}

@variant
export outlineButton = frame : Button {
  name: "Outline Button",
  left: 200px,
  top: 0px,
  fill: #00000000,
  border: { width: 1px, color: tokens.colors.brand700 },
  label {
    fill: tokens.colors.brand900
  }
}

@variant
export secondaryButton = frame : Button {
  name: "Secondary Button",
  left: 400px,
  top: 0px,
  fill: tokens.colors.brand100,
  label {
    fill: tokens.colors.brand900
  }
}
