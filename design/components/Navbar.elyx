import "design/tokens.elyx" as tokens

export Navbar = frame {
  left: 0px,
  top: 0px,
  width: 1200px,
  layout: {justify-content: .space-between, align-items: .center},
  fill: tokens.colors.bgCanvas,
  border: {color: tokens.colors.borderSubtle, sides: .bottom},
  padding: [16px, 32px],
  children: [brandLink, navLinks],

  brandLink = frame {
    layout: {align-items: .center, item-gap: 8px},
    children: brandTitle,

    brandTitle = text {
      fill: tokens.colors.brand950,
      contents: "RICHARD EARL LADOW JR.",
      font-size: 12,
      font-family: "Cabin",
      font-style: "Bold",
      letter-spacing: 25%
    }
  }

  navLinks = frame {
    layout: {align-items: .center, item-gap: 24px},
    children: [linkDetails, linkMemories, rsvpBtn],

    linkDetails = text {
      left: 0px,
      top: 7px,
      width: .auto,
      height: 17px,
      fill: tokens.colors.brand800,
      contents: "SERVICE",
      font-size: 12,
      font-family: tokens.typography.fontSans,
      font-style: "SemiBold",
      letter-spacing: 15%
    }

    linkMemories = text {
      fill: tokens.colors.brand800,
      contents: "SHARE A MEMORY",
      font-size: 12,
      font-family: tokens.typography.fontSans,
      font-style: "SemiBold",
      letter-spacing: 15%
    }

    rsvpBtn = frame {
      layout: {justify-content: .center, align-items: .center},
      fill: tokens.colors.brand900,
      corner-radius: tokens.lengths.radius-sm,
      padding: [8px, 16px],
      children: rsvpLabel,

      rsvpLabel = text {
        fill: tokens.colors.textLight,
        contents: "RSVP",
        font-size: 12,
        font-family: tokens.typography.fontSans,
        font-style: "Bold",
        letter-spacing: 10%
      }
    }
  }
}
