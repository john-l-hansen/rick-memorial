import "../tokens.elyx" as tokens
import "../../public/images/rick-01.png" as photo1
import "../../public/images/rick-02.png" as photo2
import "../../public/images/rick-03.png" as photo3

export PhotoGallery = frame {
  name: "Photo Gallery",
  left: 0px,
  top: 0px,
  width: 860px,
  layout: { direction: .column, align-items: .center, item-gap: 24px },
  children: [sectionHeading, gridContainer],

  sectionHeading = frame {
    layout: { direction: .column, align-items: .center, item-gap: 8px },
    children: [tagline, title],
    tagline = text {
      contents: "MEMORIES & MOMENTS",
      font-size: 12,
      font-family: tokens.typography.fontSans,
      fill: tokens.colors.brand700
    },
    title = text {
      contents: "Remembering the Life He Lived",
      font-size: 28,
      font-family: tokens.typography.fontSerif,
      fill: tokens.colors.brand950
    }
  },

  gridContainer = frame {
    layout: { direction: .row, item-gap: 16px, justify-content: .center },
    children: [photoItem1, photoItem2, photoItem3],

    photoItem1 = frame {
      width: 260px,
      height: 260px,
      corner-radius: tokens.lengths.radius-sm,
      fill: { image: { ref: photo1, sizing: .fill } },
      border: { width: 1px, color: tokens.colors.brand200 }
    },

    photoItem2 = frame {
      width: 260px,
      height: 260px,
      corner-radius: tokens.lengths.radius-sm,
      fill: { image: { ref: photo2, sizing: .fill } },
      border: { width: 1px, color: tokens.colors.brand200 }
    },

    photoItem3 = frame {
      width: 260px,
      height: 260px,
      corner-radius: tokens.lengths.radius-sm,
      fill: { image: { ref: photo3, sizing: .fill } },
      border: { width: 1px, color: tokens.colors.brand200 }
    }
  }
}
